<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://xplanung-light/bpmn">
<bpmn:collaboration id="Collaboration_1">
<bpmn:participant id="Part_A" name="Antragsteller (angemeldeter Nutzer)" processRef="P_A" />
<bpmn:participant id="Part_S" name="XPlanung Light (System)" processRef="P_S" />
<bpmn:participant id="Part_F" name="Zentraladmin / Orga-Admin (Freigeber)" processRef="P_F" />
<bpmn:messageFlow id="M1" name="Antrag" sourceRef="A1" targetRef="S0" />
<bpmn:messageFlow id="M2" name="Eingangsmail" sourceRef="S4" targetRef="F0" />
<bpmn:messageFlow id="M3" name="Entscheidung" sourceRef="F2" targetRef="D0" />
<bpmn:messageFlow id="M4" name="Entscheidungsmail" sourceRef="D5" targetRef="ACe" />
<bpmn:messageFlow id="M5" name="Antragsliste" sourceRef="Dend" targetRef="Fc" />
<bpmn:messageFlow id="M6" name="Fehlermeldung" sourceRef="Derr" targetRef="Fc" />
</bpmn:collaboration>
<bpmn:process id="P_A" isExecutable="false">
<bpmn:startEvent id="A0" name="Rolle für Gebietskörperschaft benötigt"></bpmn:startEvent>
<bpmn:userTask id="A1" name="Rollenantrag stellen (Rolle, Gebietskörperschaften)"><bpmn:documentation>RequestForRoleCreateView, Login erforderlich. Rollen: TOEB-Reporter (TR) oder Organisationsadministrator (OA); mehrere Gebietskörperschaften pro Antrag möglich. Der Antragsteller kann seinen Antrag selbst löschen (Besitzer oder Superuser).</bpmn:documentation></bpmn:userTask>
<bpmn:intermediateCatchEvent id="ACe" name="Entscheidung per E-Mail"><bpmn:messageEventDefinition id="med_ace" /></bpmn:intermediateCatchEvent>
<bpmn:exclusiveGateway id="AX"></bpmn:exclusiveGateway>
<bpmn:endEvent id="A_endr" name="Antrag abgelehnt (Begründung per E-Mail)"></bpmn:endEvent>
<bpmn:endEvent id="A_endc" name="Rolle zugewiesen"></bpmn:endEvent>
<bpmn:sequenceFlow id="SA1" sourceRef="A0" targetRef="A1" />
<bpmn:sequenceFlow id="SA2" sourceRef="A1" targetRef="ACe" />
<bpmn:sequenceFlow id="SA3" sourceRef="ACe" targetRef="AX" />
<bpmn:sequenceFlow id="SA4" name="abgelehnt" sourceRef="AX" targetRef="A_endr" />
<bpmn:sequenceFlow id="SA5" name="bestätigt" sourceRef="AX" targetRef="A_endc" />
</bpmn:process>
<bpmn:process id="P_S" isExecutable="false">
<bpmn:startEvent id="S0" name="Antrag eingereicht"><bpmn:messageEventDefinition id="med_s0" /></bpmn:startEvent>
<bpmn:serviceTask id="S1" name="Antrag speichern (Antragsteller, Rolle, Organisationen)"></bpmn:serviceTask>
<bpmn:exclusiveGateway id="S2" name="Rolle = TOEB-Reporter?"></bpmn:exclusiveGateway>
<bpmn:serviceTask id="S3" name="Admins aller beantragten Organisationen ermitteln (Kopie)"><bpmn:documentation>Nur Orga-Admins, die Admin für ALLE beantragten Organisationen sind, kommen in CC (get_admin_users_for_all_orgas).</bpmn:documentation></bpmn:serviceTask>
<bpmn:exclusiveGateway id="SM"></bpmn:exclusiveGateway>
<bpmn:sendTask id="S4" name="Eingangsmail an Zentraladmin (+ Orga-Admins) senden"><bpmn:documentation>An: Kontaktadresse der Anwendung; CC bei TOEB-Reporter-Anträgen: die ermittelten Orga-Admins. Enthält den Link auf die Antragsliste.</bpmn:documentation></bpmn:sendTask>
<bpmn:endEvent id="S4e" name="Antrag erfasst"></bpmn:endEvent>
<bpmn:sequenceFlow id="SS1" sourceRef="S0" targetRef="S1" />
<bpmn:sequenceFlow id="SS2" sourceRef="S1" targetRef="S2" />
<bpmn:sequenceFlow id="SS3" name="ja" sourceRef="S2" targetRef="S3" />
<bpmn:sequenceFlow id="SS4" name="nein" sourceRef="S2" targetRef="SM" />
<bpmn:sequenceFlow id="SS5" sourceRef="S3" targetRef="SM" />
<bpmn:sequenceFlow id="SS6" sourceRef="SM" targetRef="S4" />
<bpmn:sequenceFlow id="SS7" sourceRef="S4" targetRef="S4e" />
<bpmn:startEvent id="D0" name="Entscheidung abgesendet"><bpmn:messageEventDefinition id="med_d0" /></bpmn:startEvent>
<bpmn:exclusiveGateway id="D1" name="Superuser oder Admin aller beantragten Orgas (nur TOEB-Reporter)?"><bpmn:documentation>Geprüft erst beim Absenden der Entscheidung (form_valid). Die Formularseite verlangt nur Login. Orga-Admins dürfen nur TOEB-Reporter-Rollen bearbeiten und nur, wenn sie Admin ALLER beantragten Organisationen sind.</bpmn:documentation></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="D2" name="Entscheidung?"></bpmn:exclusiveGateway>
<bpmn:serviceTask id="D3" name="Rolle zuweisen, Antrag als bestätigt abschließen"><bpmn:documentation>Je Organisation AdminOrgaUser anlegen oder aktualisieren: OA setzt is_admin = true, TR setzt is_toeb_reporter = true. Vermerk speichern, Grund = bestätigt, Antrag löschen (Verlauf bleibt in der Historie).</bpmn:documentation></bpmn:serviceTask>
<bpmn:serviceTask id="D6" name="Antrag mit Begründung als zurückgewiesen abschließen"><bpmn:documentation>Begründung (editing_note) speichern, Grund = zurückgewiesen, Antrag löschen (Verlauf bleibt in der Historie).</bpmn:documentation></bpmn:serviceTask>
<bpmn:exclusiveGateway id="DM"></bpmn:exclusiveGateway>
<bpmn:sendTask id="D5" name="Entscheidungsmail an Antragsteller senden"><bpmn:documentation>Bestätigung bzw. Ablehnung (mit Begründung), ggf. mit Kontakt des bearbeitenden Orga-Admins.</bpmn:documentation></bpmn:sendTask>
<bpmn:endEvent id="Dend" name="Antragsliste aktualisiert"><bpmn:messageEventDefinition id="med_dend" /></bpmn:endEvent>
<bpmn:endEvent id="Derr" name="Fehlermeldung (keine Berechtigung)"><bpmn:messageEventDefinition id="med_derr" /></bpmn:endEvent>
<bpmn:sequenceFlow id="SD1" sourceRef="D0" targetRef="D1" />
<bpmn:sequenceFlow id="SD2" name="ja" sourceRef="D1" targetRef="D2" />
<bpmn:sequenceFlow id="SD3" name="nein" sourceRef="D1" targetRef="Derr" />
<bpmn:sequenceFlow id="SD4" name="bestätigen" sourceRef="D2" targetRef="D3" />
<bpmn:sequenceFlow id="SD5" name="zurückweisen" sourceRef="D2" targetRef="D6" />
<bpmn:sequenceFlow id="SD6" sourceRef="D3" targetRef="DM" />
<bpmn:sequenceFlow id="SD7" sourceRef="D6" targetRef="DM" />
<bpmn:sequenceFlow id="SD8" sourceRef="DM" targetRef="D5" />
<bpmn:sequenceFlow id="SD9" sourceRef="D5" targetRef="Dend" />
</bpmn:process>
<bpmn:process id="P_F" isExecutable="false">
<bpmn:startEvent id="F0" name="Antrag eingegangen (E-Mail)"><bpmn:messageEventDefinition id="med_f0" /></bpmn:startEvent>
<bpmn:userTask id="F1" name="Antrag in Antragsliste prüfen"><bpmn:documentation>Superuser sieht alle Anträge. Orga-Admins sehen nur TOEB-Reporter-Anträge, bei denen sie Admin aller beantragten Organisationen sind.</bpmn:documentation></bpmn:userTask>
<bpmn:userTask id="F2" name="Entscheidung erfassen (bestätigen mit Vermerk / zurückweisen mit Begründung)"></bpmn:userTask>
<bpmn:intermediateCatchEvent id="Fc" name="Rückmeldung zur Entscheidung"><bpmn:messageEventDefinition id="med_fc" /></bpmn:intermediateCatchEvent>
<bpmn:endEvent id="Fend" name="Antrag bearbeitet"></bpmn:endEvent>
<bpmn:sequenceFlow id="SF1" sourceRef="F0" targetRef="F1" />
<bpmn:sequenceFlow id="SF2" sourceRef="F1" targetRef="F2" />
<bpmn:sequenceFlow id="SF3" sourceRef="F2" targetRef="Fc" />
<bpmn:sequenceFlow id="SF4" sourceRef="Fc" targetRef="Fend" />
</bpmn:process>
