<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://xplanung-light/bpmn">
<bpmn:collaboration id="Collaboration_1">
<bpmn:participant id="Part_B" name="Bürger / Öffentlichkeit (Gast)" processRef="P_B" />
<bpmn:participant id="Part_S" name="XPlanung Light (System)" processRef="P_S" />
<bpmn:participant id="Part_T" name="TOEB-Vertreter" processRef="P_T" />
<bpmn:participant id="Part_K" name="Gebietskörperschaft / Kommune" processRef="P_K" />
<bpmn:messageFlow id="M1" name="Beitrag (Formular + Captcha)" sourceRef="B1" targetRef="S0" />
<bpmn:messageFlow id="M2" name="Aktivierungsmail" sourceRef="S3" targetRef="B_catch" />
<bpmn:messageFlow id="M3" name="Aktivierungslink" sourceRef="B2" targetRef="S4s" />
<bpmn:messageFlow id="M4" name="Beitrag aktiv" sourceRef="S6" targetRef="CA" />
<bpmn:messageFlow id="M5" name="TOEBs ausgewählt" sourceRef="K3" targetRef="N0" />
<bpmn:messageFlow id="M6" name="Benachrichtigung mit Direktlink" sourceRef="Nend" targetRef="T_start" />
<bpmn:messageFlow id="M7" name="TOEB-Beitrag" sourceRef="T1" targetRef="CA" />
</bpmn:collaboration>
<bpmn:process id="P_B" isExecutable="false">
<bpmn:startEvent id="B_start" name="Möchte sich online beteiligen"></bpmn:startEvent>
<bpmn:userTask id="B1" name="Online-Beitrag erfassen (inkl. Captcha)"><bpmn:documentation>Formular mit Titel, Beschreibung, Name, E-Mail, Anhängen und Captcha (BeteiligungBeitragCreateView).</bpmn:documentation></bpmn:userTask>
<bpmn:intermediateCatchEvent id="B_catch" name="Aktivierungsmail erhalten"><bpmn:messageEventDefinition id="med_bc" /></bpmn:intermediateCatchEvent>
<bpmn:userTask id="B2" name="Beitrag per Aktivierungslink bestätigen"><bpmn:documentation>Optional: Rücknahme (withdraw) und Reaktivierung über Gast-Session (UUID in Session / Authentifizierung per E-Mail-Adresse).</bpmn:documentation></bpmn:userTask>
<bpmn:endEvent id="B_end" name="Beitrag eingereicht"></bpmn:endEvent>
<bpmn:sequenceFlow id="SB1" sourceRef="B_start" targetRef="B1" />
<bpmn:sequenceFlow id="SB2" sourceRef="B1" targetRef="B_catch" />
<bpmn:sequenceFlow id="SB3" sourceRef="B_catch" targetRef="B2" />
<bpmn:sequenceFlow id="SB4" sourceRef="B2" targetRef="B_end" />
</bpmn:process>
<bpmn:process id="P_S" isExecutable="false">
<bpmn:startEvent id="S0" name="Beitrag abgesendet"><bpmn:messageEventDefinition id="med_s0" /></bpmn:startEvent>
<bpmn:exclusiveGateway id="S1" name="Online zugelassen &amp; Frist läuft?"><bpmn:documentation>Nur Typ Auslegung (1000) oder frühzeitige Öffentlichkeitsbeteiligung (10001), allow_online_beitrag = True und start_datum &lt;= heute &lt;= end_datum.</bpmn:documentation></bpmn:exclusiveGateway>
<bpmn:serviceTask id="S2" name="Beitrag speichern (approved = false)"></bpmn:serviceTask>
<bpmn:sendTask id="S3" name="Aktivierungsmail senden"><bpmn:documentation>E-Mail mit Aktivierungslink (beteiligungbeitrag-activate); UUID des Beitrags wird in der Session gemerkt.</bpmn:documentation></bpmn:sendTask>
<bpmn:endEvent id="S3e" name="Mail versendet"></bpmn:endEvent>
<bpmn:endEvent id="SRej" name="Abgelehnt (403)"></bpmn:endEvent>
<bpmn:startEvent id="S4s" name="Aktivierungslink aufgerufen"><bpmn:messageEventDefinition id="med_s4" /></bpmn:startEvent>
<bpmn:serviceTask id="S5" name="Beitrag freischalten (approved = true)"></bpmn:serviceTask>
<bpmn:endEvent id="S6" name="Beitrag aktiv"><bpmn:messageEventDefinition id="med_s6" /></bpmn:endEvent>
<bpmn:sequenceFlow id="SS1" sourceRef="S0" targetRef="S1" />
<bpmn:sequenceFlow id="SS2" name="ja" sourceRef="S1" targetRef="S2" />
<bpmn:sequenceFlow id="SS3" sourceRef="S2" targetRef="S3" />
<bpmn:sequenceFlow id="SS4" sourceRef="S3" targetRef="S3e" />
<bpmn:sequenceFlow id="SS5" name="nein" sourceRef="S1" targetRef="SRej" />
<bpmn:sequenceFlow id="SS6" sourceRef="S4s" targetRef="S5" />
<bpmn:sequenceFlow id="SS7" sourceRef="S5" targetRef="S6" />
<bpmn:startEvent id="N0" name="Benachrichtigung ausgelöst"><bpmn:messageEventDefinition id="med_n0" /></bpmn:startEvent>
<bpmn:serviceTask id="N1" name="Mails an Editoren der gewählten TOEBs senden, Protokoll speichern"><bpmn:documentation>BeteiligungToebNotificationCreateView: je ausgewählter ToebUnit eine Mail an alle Editoren mit Direktlink; Ergebnis im Feld protocol.</bpmn:documentation></bpmn:serviceTask>
<bpmn:endEvent id="Nend" name="TOEB benachrichtigt"><bpmn:messageEventDefinition id="med_ne" /></bpmn:endEvent>
<bpmn:sequenceFlow id="SN1" sourceRef="N0" targetRef="N1" />
<bpmn:sequenceFlow id="SN2" sourceRef="N1" targetRef="Nend" />
</bpmn:process>
<bpmn:process id="P_T" isExecutable="false">
<bpmn:startEvent id="T_start" name="Benachrichtigung erhalten"><bpmn:messageEventDefinition id="med_ts" /></bpmn:startEvent>
<bpmn:userTask id="T1" name="Beitrag erfassen (als Editor der zugewiesenen ToebUnit)"><bpmn:documentation>Login erforderlich. Zulässig nur, wenn die ToebUnit der Beteiligung zugewiesen ist und der Nutzer Editor genau dieser ToebUnit ist (oder Superuser).</bpmn:documentation></bpmn:userTask>
<bpmn:endEvent id="T_end" name="Beitrag abgegeben"></bpmn:endEvent>
<bpmn:sequenceFlow id="ST1" sourceRef="T_start" targetRef="T1" />
<bpmn:sequenceFlow id="ST2" sourceRef="T1" targetRef="T_end" />
</bpmn:process>
<bpmn:process id="P_K" isExecutable="false">
<bpmn:laneSet id="LaneSet_K"><bpmn:lane id="Lane_K" name="Sachbearbeiter / Gemeinde-Admin"><bpmn:flowNodeRef>K0</bpmn:flowNodeRef><bpmn:flowNodeRef>K1</bpmn:flowNodeRef><bpmn:flowNodeRef>K2</bpmn:flowNodeRef><bpmn:flowNodeRef>K3</bpmn:flowNodeRef><bpmn:flowNodeRef>KJ</bpmn:flowNodeRef><bpmn:flowNodeRef>EBG</bpmn:flowNodeRef><bpmn:flowNodeRef>CA</bpmn:flowNodeRef><bpmn:flowNodeRef>CB</bpmn:flowNodeRef><bpmn:flowNodeRef>KMan</bpmn:flowNodeRef><bpmn:flowNodeRef>KM</bpmn:flowNodeRef><bpmn:flowNodeRef>SP</bpmn:flowNodeRef><bpmn:flowNodeRef>KEnd</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
<bpmn:startEvent id="K0" name="Bauleitplan veröffentlicht"></bpmn:startEvent>
<bpmn:userTask id="K1" name="Beteiligungsverfahren anlegen"><bpmn:documentation>Typ, Bekanntmachung, Beginn, Ende, Online-Stellungnahme zulassen, bei Trägerbeteiligung zugewiesene TOEBs (BPlan- bzw. FPlanBeteiligung).</bpmn:documentation></bpmn:userTask>
<bpmn:exclusiveGateway id="K2" name="Beteiligungstyp?"></bpmn:exclusiveGateway>
<bpmn:userTask id="K3" name="TOEB benachrichtigen"><bpmn:documentation>TOEBs auswählen, Hinweistext. Nur zwischen Bekanntmachung und Ende der Beteiligung zulässig.</bpmn:documentation></bpmn:userTask>
<bpmn:exclusiveGateway id="KJ"></bpmn:exclusiveGateway>
<bpmn:eventBasedGateway id="EBG"></bpmn:eventBasedGateway>
<bpmn:intermediateCatchEvent id="CA" name="Beitrag eingegangen (online / TOEB)"><bpmn:messageEventDefinition id="med_ca" /></bpmn:intermediateCatchEvent>
<bpmn:intermediateCatchEvent id="CB" name="Beitrag per E-Mail / Post / Niederschrift"><bpmn:messageEventDefinition id="med_cb" /></bpmn:intermediateCatchEvent>
<bpmn:userTask id="KMan" name="Beitrag manuell erfassen"><bpmn:documentation>BeteiligungBeitragGenericCreateView (Gemeinde-Admin): Eingangsart E-Mail, schriftlich oder Niederschrift.</bpmn:documentation></bpmn:userTask>
<bpmn:exclusiveGateway id="KM"></bpmn:exclusiveGateway>
<bpmn:subProcess id="SP" name="Je Beitrag bearbeiten"><bpmn:multiInstanceLoopCharacteristics isSequential="false" /><bpmn:startEvent id="I0"></bpmn:startEvent><bpmn:userTask id="I1" name="Beitrag prüfen (freischalten / zurückgezogen)"><bpmn:documentation>Gemeinde-Admin: Beitrag in der Liste prüfen, freischalten (approved) oder Rücknahme (withdrawn) verwalten.</bpmn:documentation></bpmn:userTask><bpmn:exclusiveGateway id="I2" name="Schwärzung nötig?"></bpmn:exclusiveGateway><bpmn:userTask id="I3" name="Anhang schwärzen"><bpmn:documentation>Geschwärzte Version je Anhang hochladen (Redacted-Anhang, Virenprüfung). Auslieferung bevorzugt die geschwärzte Version; Original nur über Original-Link.</bpmn:documentation></bpmn:userTask><bpmn:exclusiveGateway id="I4"></bpmn:exclusiveGateway><bpmn:userTask id="I5" name="Stellungnahme erfassen (Abwägung)"><bpmn:documentation>Stellungnahme der Verwaltung mit Bezug und Berücksichtigungs-Tags (B, U, H, K, N, P, T, V, Z); K, V, N, Z nur einzeln.</bpmn:documentation></bpmn:userTask><bpmn:endEvent id="I6"></bpmn:endEvent><bpmn:sequenceFlow id="SI1" sourceRef="I0" targetRef="I1" /><bpmn:sequenceFlow id="SI2" sourceRef="I1" targetRef="I2" /><bpmn:sequenceFlow id="SI3" name="ja" sourceRef="I2" targetRef="I3" /><bpmn:sequenceFlow id="SI4" sourceRef="I3" targetRef="I4" /><bpmn:sequenceFlow id="SI5" name="nein" sourceRef="I2" targetRef="I4" /><bpmn:sequenceFlow id="SI6" sourceRef="I4" targetRef="I5" /><bpmn:sequenceFlow id="SI7" sourceRef="I5" targetRef="I6" /></bpmn:subProcess>
<bpmn:endEvent id="KEnd" name="Beiträge bewertet"></bpmn:endEvent>
<bpmn:sequenceFlow id="SK1" sourceRef="K0" targetRef="K1" />
<bpmn:sequenceFlow id="SK2" sourceRef="K1" targetRef="K2" />
<bpmn:sequenceFlow id="SK3" name="Träger" sourceRef="K2" targetRef="K3" />
<bpmn:sequenceFlow id="SK4" name="Öffentlichkeit" sourceRef="K2" targetRef="KJ" />
<bpmn:sequenceFlow id="SK5" sourceRef="K3" targetRef="KJ" />
<bpmn:sequenceFlow id="SK6" sourceRef="KJ" targetRef="EBG" />
<bpmn:sequenceFlow id="SK7" sourceRef="EBG" targetRef="CA" />
<bpmn:sequenceFlow id="SK8" sourceRef="EBG" targetRef="CB" />
<bpmn:sequenceFlow id="SK9" sourceRef="CA" targetRef="KM" />
<bpmn:sequenceFlow id="SK10" sourceRef="CB" targetRef="KMan" />
<bpmn:sequenceFlow id="SK11" sourceRef="KMan" targetRef="KM" />
<bpmn:sequenceFlow id="SK12" sourceRef="KM" targetRef="SP" />
<bpmn:sequenceFlow id="SK13" sourceRef="SP" targetRef="KEnd" />
</bpmn:process>
