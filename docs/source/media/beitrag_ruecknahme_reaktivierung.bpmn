<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://xplanung-light/bpmn">
<bpmn:collaboration id="Collaboration_1">
<bpmn:participant id="Part_G" name="Beitragsteller (Gast)" processRef="P_G" />
<bpmn:participant id="Part_S" name="XPlanung Light (System)" processRef="P_S" />
<bpmn:messageFlow id="M1" name="Aktionslink" sourceRef="G1" targetRef="SW0" />
<bpmn:messageFlow id="M2" name="Weiterleitung" sourceRef="SW2" targetRef="GCa" />
<bpmn:messageFlow id="M3" name="E-Mail-Adresse" sourceRef="G2" targetRef="SC" />
<bpmn:messageFlow id="M4" name="Ergebnis" sourceRef="SE3" targetRef="GCr" />
<bpmn:messageFlow id="M5" name="Detailseite" sourceRef="SEg" targetRef="GCb" />
</bpmn:collaboration>
<bpmn:process id="P_G" isExecutable="false">
<bpmn:startEvent id="G0" name="Rücknahme / Reaktivierung gewünscht"></bpmn:startEvent>
<bpmn:userTask id="G1" name="Aktionslink aufrufen (zurückziehen / reaktivieren)"><bpmn:documentation>Link aus der Aktivierungsmail bzw. von der Detailseite des Beitrags (beteiligungbeitrag-withdraw / -reactivate, jeweils mit UUID des Beitrags).</bpmn:documentation></bpmn:userTask>
<bpmn:eventBasedGateway id="GE1"></bpmn:eventBasedGateway>
<bpmn:intermediateCatchEvent id="GCb" name="Detailseite mit neuem Status"><bpmn:messageEventDefinition id="med_gcb" /></bpmn:intermediateCatchEvent>
<bpmn:endEvent id="G_end" name="Beitrag zurückgezogen / reaktiviert"></bpmn:endEvent>
<bpmn:intermediateCatchEvent id="GCa" name="Authentifizierungsformular"><bpmn:messageEventDefinition id="med_gca" /></bpmn:intermediateCatchEvent>
<bpmn:userTask id="G2" name="E-Mail-Adresse angeben"><bpmn:documentation>Es muss die E-Mail-Adresse sein, mit der der Beitrag eingereicht wurde.</bpmn:documentation></bpmn:userTask>
<bpmn:intermediateCatchEvent id="GCr" name="Ergebnis der Authentifizierung"><bpmn:messageEventDefinition id="med_gcr" /></bpmn:intermediateCatchEvent>
<bpmn:exclusiveGateway id="GX" name="Authentifiziert?"></bpmn:exclusiveGateway>
<bpmn:sequenceFlow id="SG1" sourceRef="G0" targetRef="G1" />
<bpmn:sequenceFlow id="SG2" sourceRef="G1" targetRef="GE1" />
<bpmn:sequenceFlow id="SG3" sourceRef="GE1" targetRef="GCb" />
<bpmn:sequenceFlow id="SG4" sourceRef="GCb" targetRef="G_end" />
<bpmn:sequenceFlow id="SG5" sourceRef="GE1" targetRef="GCa" />
<bpmn:sequenceFlow id="SG6" sourceRef="GCa" targetRef="G2" />
<bpmn:sequenceFlow id="SG7" sourceRef="G2" targetRef="GCr" />
<bpmn:sequenceFlow id="SG8" sourceRef="GCr" targetRef="GX" />
<bpmn:sequenceFlow id="SG9" name="ja (erneut aufrufen)" sourceRef="GX" targetRef="G1" />
<bpmn:sequenceFlow id="SG10" name="nein" sourceRef="GX" targetRef="G2" />
</bpmn:process>
<bpmn:process id="P_S" isExecutable="false">
<bpmn:startEvent id="SW0" name="Aktionslink aufgerufen"><bpmn:messageEventDefinition id="med_sw0" /></bpmn:startEvent>
<bpmn:exclusiveGateway id="SW1" name="Gemeinde-Admin / Superuser oder UUID in Session?"><bpmn:documentation>Zugriff, wenn Nutzer Admin einer Gebietskörperschaft des Plans oder Superuser ist, oder die UUID des Beitrags in der Session liegt (gesetzt nach Authentifizierung). Gilt für Zurückziehen und Reaktivieren.</bpmn:documentation></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="SW5" name="Aktion laut Link?"></bpmn:exclusiveGateway>
<bpmn:serviceTask id="SW6" name="Beitrag zurückziehen (withdrawn = true)"><bpmn:documentation>Nur wenn withdrawn noch false ist. Der Beitrag zählt danach nicht mehr als bestätigter Beitrag in der Übersicht der Beteiligungen.</bpmn:documentation></bpmn:serviceTask>
<bpmn:serviceTask id="SW7" name="Beitrag reaktivieren (withdrawn = false)"><bpmn:documentation>Nur wenn withdrawn true ist. Der Beitrag zählt wieder als bestätigt, sofern approved = true.</bpmn:documentation></bpmn:serviceTask>
<bpmn:exclusiveGateway id="SWn"></bpmn:exclusiveGateway>
<bpmn:endEvent id="SEg" name="Detailseite (Gast) bzw. Beitragsliste (Admin)"><bpmn:messageEventDefinition id="med_seg" /></bpmn:endEvent>
<bpmn:sequenceFlow id="SS1" sourceRef="SW0" targetRef="SW1" />
<bpmn:sequenceFlow id="SS2" name="ja" sourceRef="SW1" targetRef="SW5" />
<bpmn:sequenceFlow id="SS3" name="zurückziehen" sourceRef="SW5" targetRef="SW6" />
<bpmn:sequenceFlow id="SS4" name="reaktivieren" sourceRef="SW5" targetRef="SW7" />
<bpmn:sequenceFlow id="SS5" sourceRef="SW6" targetRef="SWn" />
<bpmn:sequenceFlow id="SS6" sourceRef="SW7" targetRef="SWn" />
<bpmn:sequenceFlow id="SS7" sourceRef="SWn" targetRef="SEg" />
<bpmn:sendTask id="SW2" name="Weiterleitung zur E-Mail-Authentifizierung"><bpmn:documentation>Redirect auf beteiligungbeitrag-authenticate mit der UUID des Beitrags.</bpmn:documentation></bpmn:sendTask>
<bpmn:intermediateCatchEvent id="SC" name="E-Mail übermittelt"><bpmn:messageEventDefinition id="med_sc" /></bpmn:intermediateCatchEvent>
<bpmn:exclusiveGateway id="SW3" name="E-Mail korrekt?"></bpmn:exclusiveGateway>
<bpmn:serviceTask id="SW4" name="UUID in Session speichern"><bpmn:documentation>request.session['beitrag_generic_id'] = UUID des Beitrags; danach Weiterleitung auf die Gast-Detailseite.</bpmn:documentation></bpmn:serviceTask>
<bpmn:exclusiveGateway id="SWk"></bpmn:exclusiveGateway>
<bpmn:endEvent id="SE3" name="Detailseite oder Fehlermeldung"><bpmn:messageEventDefinition id="med_se3" /></bpmn:endEvent>
<bpmn:sequenceFlow id="SS8" name="nein" sourceRef="SW1" targetRef="SW2" />
<bpmn:sequenceFlow id="SS9" sourceRef="SW2" targetRef="SC" />
<bpmn:sequenceFlow id="SS10" sourceRef="SC" targetRef="SW3" />
<bpmn:sequenceFlow id="SS11" name="ja" sourceRef="SW3" targetRef="SW4" />
<bpmn:sequenceFlow id="SS12" name="nein" sourceRef="SW3" targetRef="SWk" />
<bpmn:sequenceFlow id="SS13" sourceRef="SW4" targetRef="SWk" />
<bpmn:sequenceFlow id="SS14" sourceRef="SWk" targetRef="SE3" />
</bpmn:process>
